{% sw_extends '@Storefront/storefront/base.html.twig' %}

{#
    B2B-Bestellseite (/quickorder): Artikel Zeile für Zeile erfassen —
    Produkt-Dropdown, daneben Größe, daneben Menge. „Weiterer Artikel"
    (oder Tab aus dem Mengenfeld) hängt die nächste Zeile an, „In den
    Warenkorb" schickt alle Zeilen gesammelt an
    frontend.quickorder.add.items.

    Die Produktliste liefert der QuickOrderController über den
    ProductOptionsLoader als frxProductGroups (Produkt → Varianten).
#}

{% block base_content %}
<div class="container mt-4 mb-5">

    {# Kopfbereich #}
    <div class="quick-order-header mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="quick-order-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.5 2H.5a.5.5 0 0 1-.5-.5zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-1.646-3-.5-2H5.646l-.5 2h5.208z"/>
                </svg>
            </div>
            <div>
                <h1 class="h3 mb-0">B2B-Bestellung</h1>
                <p class="text-muted mb-0 small">Artikel nacheinander erfassen und gesammelt in den Warenkorb legen</p>
            </div>
        </div>
    </div>

    {# Flash-Meldungen #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-3" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card quick-order-card">
        <div class="card-body p-0">
            <form action="{{ path('frontend.quickorder.add.items') }}" method="post" id="quick-order-form" novalidate>
                <div class="quick-order-table-wrapper">
                    <table class="table quick-order-table mb-0">
                        <thead>
                            <tr>
                                <th class="quick-order-col-index" scope="col">#</th>
                                <th scope="col">Produkt</th>
                                <th class="quick-order-col-variant" scope="col">Größe</th>
                                <th class="quick-order-col-qty" scope="col">Menge</th>
                                <th class="quick-order-col-action" scope="col" aria-label="Aktionen"></th>
                            </tr>
                        </thead>
                        <tbody id="quick-order-rows">
                            {# eine Startzeile; weitere kommen per Button/Tab dazu #}
                        </tbody>
                    </table>
                </div>

                <div class="quick-order-footer">
                    <button type="button" id="quick-order-add-row" class="btn btn-outline-secondary btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                        </svg>
                        Weiterer Artikel
                    </button>

                    <div class="quick-order-actions">
                        <button type="button" id="quick-order-clear" class="btn btn-ghost-secondary btn-sm">
                            Liste leeren
                        </button>
                        <button type="submit" class="btn btn-primary quick-order-submit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                                <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.5 2H.5a.5.5 0 0 1-.5-.5z"/>
                            </svg>
                            In den Warenkorb
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="quick-order-hint mt-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" class="me-1 flex-shrink-0" style="margin-top:1px">
            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
        </svg>
        Tab aus dem Mengenfeld der letzten Zeile legt automatisch die nächste Zeile an. Zeilen ohne Produktauswahl werden ignoriert.
    </div>

</div>

{# Zeilen-Vorlage: Namen erhalten beim Einfügen den Zeilenindex #}
<template id="quick-order-row-template">
    <tr class="quick-order-row">
        <td class="quick-order-col-index"><span class="row-index text-muted">0</span></td>
        <td>
            <select class="form-select quick-order-product" aria-label="Produkt wählen">
                <option value="">– Produkt wählen –</option>
            </select>
        </td>
        <td class="quick-order-col-variant">
            <select class="form-select quick-order-variant" name="items[0][number]" aria-label="Größe wählen" disabled>
                <option value="">–</option>
            </select>
        </td>
        <td class="quick-order-col-qty">
            <div class="input-group input-group-sm">
                <button type="button" class="btn btn-outline-secondary btn-qty-minus" title="Verringern">−</button>
                <input type="number" name="items[0][quantity]" class="form-control quick-order-qty text-center"
                       value="1" min="1" max="9999" inputmode="numeric" style="max-width: 64px">
                <button type="button" class="btn btn-outline-secondary btn-qty-plus" title="Erhöhen">+</button>
            </div>
        </td>
        <td class="quick-order-col-action">
            <button type="button" class="btn btn-icon btn-remove-row" title="Zeile entfernen" aria-label="Zeile entfernen">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                </svg>
            </button>
        </td>
    </tr>
</template>

<script type="application/json" id="frxProductData">{{ frxProductGroups|default([])|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
<script>
(function () {
    'use strict';

    var data = JSON.parse(document.getElementById('frxProductData').textContent);
    var tbody = document.getElementById('quick-order-rows');
    var template = document.getElementById('quick-order-row-template');
    var addBtn = document.getElementById('quick-order-add-row');
    var clearBtn = document.getElementById('quick-order-clear');

    if (!tbody || !template || !addBtn) {
        return;
    }

    function fillVariants(row, groupIndex) {
        var variantSelect = row.querySelector('.quick-order-variant');
        variantSelect.innerHTML = '';

        var group = data[groupIndex];
        if (!group) {
            variantSelect.disabled = true;
            variantSelect.appendChild(new Option('–', ''));
            return;
        }

        group.variants.forEach(function (variant) {
            variantSelect.appendChild(new Option(variant.label + ' · ' + variant.number, variant.number));
        });
        variantSelect.disabled = false;
    }

    function createRow() {
        var row = template.content.firstElementChild.cloneNode(true);
        var productSelect = row.querySelector('.quick-order-product');

        data.forEach(function (group, index) {
            productSelect.appendChild(new Option(group.label, String(index)));
        });

        productSelect.addEventListener('change', function () {
            fillVariants(row, productSelect.value);
        });

        return row;
    }

    function updateIndices() {
        tbody.querySelectorAll('.quick-order-row').forEach(function (row, i) {
            var idx = i + 1;
            row.querySelector('.row-index').textContent = idx;
            row.querySelectorAll('[name]').forEach(function (input) {
                input.name = input.name.replace(/items\[\d+\]/, 'items[' + idx + ']');
            });
            var removeBtn = row.querySelector('.btn-remove-row');
            if (removeBtn) {
                removeBtn.disabled = (tbody.querySelectorAll('.quick-order-row').length === 1);
            }
        });
    }

    function addRow(focus) {
        var row = createRow();
        tbody.appendChild(row);
        updateIndices();
        if (focus) {
            row.querySelector('.quick-order-product').focus();
        }
        return row;
    }

    addBtn.addEventListener('click', function () {
        addRow(true);
    });

    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            tbody.innerHTML = '';
            addRow(true);
        });
    }

    tbody.addEventListener('click', function (e) {
        var minus = e.target.closest('.btn-qty-minus');
        var plus = e.target.closest('.btn-qty-plus');
        var remove = e.target.closest('.btn-remove-row');

        if (minus || plus) {
            var qty = (minus || plus).closest('.input-group').querySelector('.quick-order-qty');
            var value = parseInt(qty.value, 10) || 1;
            var max = parseInt(qty.max, 10) || 9999;
            qty.value = minus ? Math.max(1, value - 1) : Math.min(max, value + 1);
            return;
        }

        if (remove && !remove.disabled) {
            remove.closest('.quick-order-row').remove();
            updateIndices();
        }
    });

    // Tab aus dem Mengenfeld der letzten Zeile → nächste Zeile anlegen
    tbody.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab' || e.shiftKey) {
            return;
        }
        var rows = tbody.querySelectorAll('.quick-order-row');
        var lastRow = rows[rows.length - 1];
        if (lastRow && e.target === lastRow.querySelector('.quick-order-qty')) {
            e.preventDefault();
            addRow(true);
        }
    });

    addRow(false);
}());
</script>
{% endblock %}
