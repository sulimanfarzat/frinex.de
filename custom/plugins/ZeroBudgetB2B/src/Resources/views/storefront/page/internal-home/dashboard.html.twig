{#
    Internes Einkaufs-Dashboard — Startseite von fritz.frinex.de.
    Statische Kacheln rendern sofort; Kennzahlen und letzte
    Anforderungen kommen per Fetch vom Summary-Endpoint.
#}

{% set hour = 'now'|date('G') %}
{% set greeting = hour < 11 ? 'Guten Morgen' : (hour < 17 ? 'Guten Tag' : 'Guten Abend') %}

<div class="frx-dash container-xxl" id="frx-dash" data-summary-url="{{ path('frontend.requisition.summary') }}">

    {# Begrüßungs-Band #}
    <section class="frx-dash-hero">
        <div class="frx-dash-hero-text">
            <p class="frx-dash-kicker">FRINEX · Interner Einkauf</p>
            <h1 class="frx-dash-title">{{ greeting }}{% if context.customer %}, {{ context.customer.firstName }}{% endif %}</h1>
            <p class="frx-dash-sub">Bedarf erfassen, Status verfolgen, nachbestellen — alles an einem Ort.</p>
            <div class="frx-dash-hero-actions">
                <a class="btn btn-light frx-dash-cta" href="{{ path('frontend.requisition.page') }}">
                    Bedarfsanforderung starten
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793L8.146 2.354a.5.5 0 1 1 .708-.708l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/></svg>
                </a>
                <a class="frx-dash-hero-link" href="{{ path('frontend.account.order.page') }}">Meine Anforderungen</a>
            </div>
        </div>
        <div class="frx-dash-hero-note" id="frx-dash-open" hidden>
            <span class="frx-dash-open-count" id="frx-dash-open-count">0</span>
            <span>offene Positionen in Ihrer aktuellen Anforderung</span>
            <a href="{{ path('frontend.requisition.page') }}">Weiter erfassen →</a>
        </div>
    </section>

    {# Schnellzugriff-Kacheln #}
    <section class="frx-dash-tiles" aria-label="Schnellzugriff">
        <a class="frx-dash-tile" href="{{ path('frontend.requisition.page') }}">
            <span class="frx-dash-tile-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-1zm0 4a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-1zm0 4a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-1z"/></svg>
            </span>
            <span class="frx-dash-tile-body">
                <strong>Alle Artikel</strong>
                <span>Katalog durchsuchen und Mengen erfassen</span>
            </span>
            <span class="frx-dash-tile-arrow" aria-hidden="true">→</span>
        </a>

        <a class="frx-dash-tile" href="{{ path('frontend.requisition.page') }}?view=favorites">
            <span class="frx-dash-tile-icon is-amber" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/></svg>
            </span>
            <span class="frx-dash-tile-body">
                <strong>Favoriten</strong>
                <span><span id="frx-dash-fav">–</span> markierte Artikel</span>
            </span>
            <span class="frx-dash-tile-arrow" aria-hidden="true">→</span>
        </a>

        <a class="frx-dash-tile" href="{{ path('frontend.requisition.page') }}?view=frequent">
            <span class="frx-dash-tile-icon is-green" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/></svg>
            </span>
            <span class="frx-dash-tile-body">
                <strong>Häufig bestellt</strong>
                <span><span id="frx-dash-freq">–</span> Artikel zum Nachbestellen</span>
            </span>
            <span class="frx-dash-tile-arrow" aria-hidden="true">→</span>
        </a>

        <a class="frx-dash-tile" href="{{ path('frontend.account.order.page') }}">
            <span class="frx-dash-tile-icon is-ink" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor"><path d="M9.5 0a.5.5 0 0 1 .5.5.5.5 0 0 0 .5.5.5.5 0 0 1 .5.5V2a.5.5 0 0 1-.5.5h-5A.5.5 0 0 1 5 2v-.5a.5.5 0 0 1 .5-.5.5.5 0 0 0 .5-.5.5.5 0 0 1 .5-.5h3z"/><path d="M3 2.5a.5.5 0 0 1 .5-.5H4a.5.5 0 0 0 0-1h-.5A1.5 1.5 0 0 0 2 2.5v12A1.5 1.5 0 0 0 3.5 16h9a1.5 1.5 0 0 0 1.5-1.5v-12A1.5 1.5 0 0 0 12.5 1H12a.5.5 0 0 0 0 1h.5a.5.5 0 0 1 .5.5v12a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-12z"/></svg>
            </span>
            <span class="frx-dash-tile-body">
                <strong>Anforderungsstatus</strong>
                <span>Bestellhistorie und Bearbeitungsstand</span>
            </span>
            <span class="frx-dash-tile-arrow" aria-hidden="true">→</span>
        </a>
    </section>

    {# Letzte Anforderungen #}
    <section class="frx-dash-orders" aria-label="Letzte Anforderungen">
        <div class="frx-dash-orders-head">
            <h2>Letzte Anforderungen</h2>
            <a href="{{ path('frontend.account.order.page') }}">Alle anzeigen →</a>
        </div>
        <div class="frx-dash-orders-wrap">
            <table class="frx-dash-orders-table">
                <thead>
                    <tr>
                        <th scope="col">Vorgang</th>
                        <th scope="col">Datum</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="is-num">Positionen</th>
                        <th scope="col" class="is-num">Wert</th>
                    </tr>
                </thead>
                <tbody id="frx-dash-orders-rows">
                    <tr><td colspan="5" class="frx-dash-orders-empty">Lade …</td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
(function () {
    'use strict';

    const root = document.getElementById('frx-dash');
    if (!root) { return; }

    const money = new Intl.NumberFormat('de-DE', { style: 'currency', currency: '{{ context.currency.isoCode }}' });

    function esc(value) {
        const div = document.createElement('div');
        div.textContent = value == null ? '' : String(value);
        return div.innerHTML;
    }

    fetch(root.dataset.summaryUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (res) { if (!res.ok) { throw new Error(); } return res.json(); })
        .then(function (data) {
            document.getElementById('frx-dash-fav').textContent = data.favoritesCount;
            document.getElementById('frx-dash-freq').textContent = data.frequentCount;

            if (data.openPositions > 0) {
                document.getElementById('frx-dash-open-count').textContent = data.openPositions;
                document.getElementById('frx-dash-open').hidden = false;
            }

            const rows = document.getElementById('frx-dash-orders-rows');
            if (!data.orders.length) {
                rows.innerHTML = '<tr><td colspan="5" class="frx-dash-orders-empty">Noch keine Anforderungen vorhanden.</td></tr>';
                return;
            }
            rows.innerHTML = data.orders.map(function (o) {
                return '<tr>' +
                    '<td class="is-number">' + esc(o.number) + '</td>' +
                    '<td>' + esc(o.date) + '</td>' +
                    '<td><span class="frx-dash-state">' + esc(o.state) + '</span></td>' +
                    '<td class="is-num">' + esc(o.positions) + '</td>' +
                    '<td class="is-num">' + money.format(o.total) + '</td>' +
                '</tr>';
            }).join('');
        })
        .catch(function () {
            document.getElementById('frx-dash-orders-rows').innerHTML =
                '<tr><td colspan="5" class="frx-dash-orders-empty">Daten konnten nicht geladen werden.</td></tr>';
        });
}());
</script>
