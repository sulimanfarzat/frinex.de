{# FRINEX Kategorien-Grid: ein Slot, Element „frinex-category-grid" #}
{% block block_frinex_category_grid %}
    {% set element = block.slots.getSlot('grid') %}
    {% if element %}
        <div class="col-12" data-cms-element-id="{{ element.id }}">
            {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' ignore missing %}
        </div>
    {% endif %}
{% endblock %}
