{# FRINEX CTA-Sektion (Registrierungsaufforderung vor dem Footer):
   ein Slot, Element „frinex-cta" #}
{% block block_frinex_cta %}
    {% set element = block.slots.getSlot('cta') %}
    {% if element %}
        <div class="col-12" data-cms-element-id="{{ element.id }}">
            {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' ignore missing %}
        </div>
    {% endif %}
{% endblock %}
