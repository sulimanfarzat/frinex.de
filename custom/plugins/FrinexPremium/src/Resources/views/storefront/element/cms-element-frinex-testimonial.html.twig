{# FRINEX Testimonial-Karte: Zitat + Name + Position/Firma + optionales
   Foto/Logo (media). Wird im Block „frinex-testimonials" 1–3× gerendert. #}
{% block element_frinex_testimonial %}
    {% set config = element.config %}
    {% set media = element.data.media %}

    <figure class="cms-element-frinex-testimonial frx-testimonial">
        <svg class="frx-testimonial-mark" aria-hidden="true" width="28" height="28" viewBox="0 0 24 24"
             fill="currentColor">
            <path d="M10 7H6a3 3 0 0 0-3 3v1a3 3 0 0 0 3 3h1v1a3 3 0 0 1-3 3v2a5 5 0 0 0 5-5V8a1 1 0 0 0-1-1h2zm11 0h-4a3 3 0 0 0-3 3v1a3 3 0 0 0 3 3h1v1a3 3 0 0 1-3 3v2a5 5 0 0 0 5-5V8a1 1 0 0 0-1-1h2z"/>
        </svg>
        <blockquote class="frx-testimonial-quote">
            {{ config.quote.value }}
        </blockquote>
        <figcaption class="frx-testimonial-author">
            {% if media %}
                {% sw_thumbnails 'frx-testimonial-image' with {
                    media: media,
                    sizes: { 'default': '96px' },
                    attributes: {
                        'class': 'frx-testimonial-avatar',
                        'alt': media.translated.alt ?: config.authorName.value ?: '',
                        'loading': 'lazy'
                    }
                } %}
            {% endif %}
            <span class="frx-testimonial-meta">
                {% if config.authorName.value %}
                    <span class="frx-testimonial-name">{{ config.authorName.value }}</span>
                {% endif %}
                {% if config.authorRole.value %}
                    <span class="frx-testimonial-role">{{ config.authorRole.value }}</span>
                {% endif %}
            </span>
        </figcaption>
    </figure>
{% endblock %}
